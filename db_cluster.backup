    space bigint,
    CONSTRAINT chk_priority CHECK ((priority = ANY (ARRAY['urgent'::text, 'high'::text, 'medium'::text, 'low'::text])))
);


ALTER TABLE public.items OWNER TO postgres;

--
-- Name: lists; Type: TABLE; Schema: public; Owner: postgres
