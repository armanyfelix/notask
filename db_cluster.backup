--
-- Name: space_data; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.space_data AS
 SELECT folders.id,
    folders.name,
    folders.folder,
    folders.space,
    'folder'::text AS type
   FROM public.folders
  WHERE (folders.space = folders.space)
UNION ALL
 SELECT lists.id,
    lists.name,
    lists.folder,
    lists.space,
    'list'::text AS type
   FROM public.lists
  WHERE (lists.space = lists.space)
UNION ALL
 SELECT notes.id,
    notes.name,
    notes.folder,
    notes.space,
    'note'::text AS type
   FROM public.notes
  WHERE (notes.space = notes.space)
  ORDER BY 2;


ALTER TABLE public.space_data OWNER TO postgres;

--
